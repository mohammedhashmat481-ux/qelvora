# Qelvora Technologies - Environment Variables

# Node Environment
NODE_ENV=development

# Email Delivery Configuration (Nodemailer / SMTP)
# Set your SMTP host, port, credentials, and notification receiver
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=qelvora.in@gmail.com
SMTP_PASS=your-app-specific-password
CONTACT_EMAIL_TO=qelvora.in@gmail.com

# Optional Resend API Key (alternative to SMTP)
# RESEND_API_KEY=re_123456789

# Website Canonical Base URL
NEXT_PUBLIC_SITE_URL=https://qelvora.in
